PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/vishant_portfolio
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5000

# Register these callback URLs in the provider consoles:
# http://localhost:5000/api/auth/google/callback
# http://localhost:5000/api/auth/github/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Custom URL scheme the mobile app registers (matches "scheme" in
# mobile/app.json). Only used to redirect back into the mobile app after
# Google/GitHub sign-in when the flow was started with ?platform=mobile —
# the website flow is unaffected.
MOBILE_APP_SCHEME=buildwithvishant

# AI assistant (OpenAI Responses API)
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-5-mini

# Sandboxed code execution. Use your self-hosted Piston server or a provisioned Piston endpoint.
EXECUTION_PROVIDER=piston
PISTON_URL=http://localhost:2000
PISTON_TOKEN=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
CONTACT_RECEIVER_EMAIL=kumarvishant602@gmail.com

# Signup email verification (reuses the SMTP_* vars above)
EMAIL_VERIFICATION_EXPIRES_MINUTES=60
EMAIL_VERIFICATION_RATE_LIMIT_MINUTES=2

ADMIN_NAME=Vishant Kumar
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeThisPassword123!
