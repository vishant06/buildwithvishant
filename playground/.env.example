# Backend API (the existing Render service)
VITE_API_URL=http://localhost:5000/api

# Where the other apps live. Fallbacks are used when these are unset:
# dev -> localhost ports, production -> the buildwithvishant.in domains.
VITE_MAIN_SITE_URL=http://localhost:5173
VITE_AI_URL=http://localhost:5175

# Optional: share the theme/session marker cookie across subdomains.
# Derived from VITE_MAIN_SITE_URL by default (e.g. .buildwithvishant.in).
# VITE_COOKIE_DOMAIN=.buildwithvishant.in
