{
  "name": "vishant-portfolio-server",
  "version": "1.0.0",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "seed:admin": "node src/seedAdmin.js",
    "sync:workspace": "node -e \"const f=require('fs');f.copyFileSync('../shared/workspace/core.js','src/utils/workspaceCore.js');f.copyFileSync('../shared/workspace/rules.js','src/utils/workspaceRules.js')\"",
    "check:workspace": "node -e \"const f=require('fs');for(const [a,b] of [['core.js','workspaceCore.js'],['rules.js','workspaceRules.js']]){if(f.readFileSync('../shared/workspace/'+a,'utf8')!==f.readFileSync('src/utils/'+b,'utf8')){console.error(b+' is out of sync: run npm run sync:workspace');process.exit(1)}}\"",
    "test": "node --test --experimental-test-module-mocks tests/*.test.js",
    "audit:playground": "node scripts/auditPlaygroundOwnership.js",
    "migrate:visibility": "node scripts/migratePlaygroundVisibility.js"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.10.0",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "groq-sdk": "^1.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0",
    "multer": "^2.0.1",
    "nodemailer": "^6.9.16",
    "pdfjs-dist": "^5.4.296",
    "pdfkit": "^0.15.0",
    "streamifier": "^0.1.1",
    "vishant-mern-portfolio": "file:.."
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  }
}
